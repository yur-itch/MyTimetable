@using System.Globalization
@using MyTimetable.Models
@model List<DaySchedule>
@{ Layout = null; }
@functions {
    static readonly string[] Weekdays = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
    static readonly string[] Months = { "января", "февраля", "марта", "апреля", "мая", "июня",
        "июля", "августа", "сентября", "октября", "ноября", "декабря" };

    static string ColorClass(string type) => type switch
    {
        "PRACTICE" => "lp",
        "SEMINAR" => "ls",
        "LECTURE" => "ll",
        "EXAM" or "CONTROL_POINT" or "DIFFERENTIAL_CREDIT" or "CREDIT" => "le",
        "CONSULTATION" => "lc",
        _ => "ld",
    };
}
@{
    var slotMap = new SortedDictionary<int, (int starts, int ends)>();
    foreach (var day in Model)
        foreach (var l in day.Lessons ?? new())
            if (!slotMap.ContainsKey(l.LessonNumber))
                slotMap[l.LessonNumber] = (l.Starts, l.Ends);
    var slots = slotMap.ToList();
    if (slots.Count > 0) slots.RemoveAt(slots.Count - 1);

    var dayMap = new SortedDictionary<DateTime, DaySchedule>();
    foreach (var day in Model)
    {
        if (!DateTime.TryParseExact(day.Date, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            continue;
        if (((int)date.DayOfWeek + 6) % 7 > 6) continue;
        dayMap[date] = day;
    }
    var days = dayMap.ToList();
}
@foreach (var kv in days)
{
    var date = kv.Key;
    var day = kv.Value;
    int dow = ((int)date.DayOfWeek + 6) % 7;
    var dateStr = date.ToString("yyyy-MM-dd");
    <div id="day-@dateStr" style="display:contents">
        <div class="cell s-left day-label">
            <div class="day-name">@Weekdays[dow]</div>
            <div class="day-date">@date.Day @Months[date.Month - 1]</div>
            <button class="refresh-btn">↻</button>
        </div>
        @foreach (var (num, t) in slots)
        {
            <div class="cell day-cell">
                @foreach (var l in day.Lessons ?? new())
                {
                    if (l.LessonNumber != num) continue;
                    if (l.Type == "LESSON")
                    {
                        <div class="lesson @ColorClass(l.LessonType)">
                            <div class="lesson-title">@l.Title</div>
                            <div class="lesson-prof">@l.Professor?.FullName</div>
                        </div>
                    }
                    else
                    {
                        <div class="lesson ld">
                            <div class="lesson-title">ПУСТО</div>
                            <div class="lesson-prof">1.5 ЧАСА ГУЛЯЕМ</div>
                        </div>
                    }
                }
            </div>
        }
    </div>
}
