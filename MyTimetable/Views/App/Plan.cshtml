@model MyTimetable.Rendering.PlanView
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Планирование</title>
    <style>
        :root {
            --bg: #0a0a0f;
            --line: #1b1b24;
            --fg: #e8e8ef;
            --sub: #6b6b7b;
            --accent: #3b82f6;
            --accent-bg: #11294d;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100%;
            background: var(--bg);
            color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .wrap { max-width: 720px; margin: 0 auto; padding: 24px 16px 64px; }

        a.back { color: var(--sub); text-decoration: none; font-size: 14px; }
        a.back:hover { color: var(--fg); }

        h1 { font-size: 20px; margin: 12px 0 20px; }
        label { display: block; font-size: 13px; color: var(--sub); margin: 18px 0 6px; }

        select, input {
            background: #13131c;
            border: 1px solid var(--line);
            color: var(--fg);
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 14px;
        }
        select { width: 100%; }
        select:focus, input:focus { outline: none; border-color: var(--accent); }

        .row { display: flex; gap: 8px; margin-bottom: 8px; }
        .row .title { flex: 1 1 auto; min-width: 0; }
        .row .count { width: 84px; }
        .del { background: #1a1320; border: 1px solid #5b2330; color: #e88; cursor: pointer; border-radius: 6px; font-size: 14px; }
        .del:hover { background: #271826; }

        .col2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
        .panel { background: #0f0f16; border: 1px solid var(--line); border-radius: 8px; padding: 12px; }

        .add { margin-top: 4px; background: #13131c; border: 1px solid var(--line); color: var(--fg); border-radius: 6px; padding: 8px 12px; font-size: 14px; cursor: pointer; }
        .add:hover { border-color: var(--accent); }

        .go { margin-top: 24px; width: 100%; background: var(--accent-bg); border: 1px solid var(--accent); color: #cfe0ff; border-radius: 8px; padding: 12px; font-size: 15px; font-weight: 600; cursor: pointer; }
        .go:hover { background: #173667; }
        .go:disabled { opacity: .5; cursor: default; }

        .reset { margin-top: 10px; width: 100%; background: #1a1320; border: 1px solid #5b2330; color: #e88; border-radius: 8px; padding: 10px; font-size: 14px; cursor: pointer; }
        .reset:hover { background: #271826; }
        .reset:disabled { opacity: .5; cursor: default; }

        .logout-btn {
            position: fixed;
            top: 8px;
            right: 8px;
            height: 32px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #1a1320;
            border: 1px solid #5b2330;
            color: #e88;
            font-size: 13px;
            cursor: pointer;
        }
        .logout-btn:hover { background: #271826; }

        #strats { min-height: 40px; }
        #strats .strat-row { display: flex; gap: 6px; align-items: center; margin-bottom: 6px; font-size: 14px; }
        #strats .strat-row .label { flex: 1 1 auto; padding: 4px 8px; background: #13131c; border-radius: 4px; }
        #strats .strat-row .mv { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; background: #13131c; border: 1px solid var(--line); color: var(--fg); border-radius: 6px; cursor: pointer; font-size: 12px; flex: 0 0 auto; }
        #strats .strat-row .mv:hover { border-color: var(--accent); }
        #strats .strat-row .del { width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }

        #result { margin-top: 18px; font-size: 14px; min-height: 20px; }
        #result.ok { color: #7ddc8e; }
        #result.err { color: #e88; }
    </style>
</head>
<body>
    <button class="logout-btn" onclick="logout()" title="Выйти">выход</button>
    <div class="wrap">
        <a class="back" href="/App">← к расписанию</a>
        <h1>Планирование пар</h1>

        <label>Предметы и количество</label>
        <div id="rows"></div>
        <button type="button" class="add" onclick="addRow()">+ предмет</button>

        <label>Стратегии (применяются стопкой, сверху вниз)</label>
        <div class="col2">
            <div>
                <div class="panel">
                    <div style="font-size:13px;color:var(--sub);margin-bottom:6px">Готовая стратегия</div>
                    <select id="prebuilt-select">
@foreach (var name in Model.PrebuiltNames)
{
                        <option value="@name">@name</option>
}
                    </select>
                    <button type="button" class="add" style="margin-top:6px;width:100%" onclick="addPrebuilt()">+ добавить</button>
                </div>
                <div class="panel" style="margin-top:12px">
                    <div style="font-size:13px;color:var(--sub);margin-bottom:6px">Собрать из компонентов</div>
                    <div style="font-size:12px;color:var(--sub);margin-bottom:4px">Picker</div>
                    <select id="picker-select">
@foreach (var name in Model.PickerNames)
{
                        <option value="@name">@name</option>
}
                    </select>
                    <div style="font-size:12px;color:var(--sub);margin:8px 0 4px">Slotter</div>
                    <select id="slotter-select">
@foreach (var name in Model.SlotterNames)
{
                        <option value="@name">@name</option>
}
                    </select>
                    <button type="button" class="add" style="margin-top:6px;width:100%" onclick="addComposed()">+ добавить</button>
                </div>
            </div>
            <div class="panel" id="strats">
                <div style="font-size:13px;color:var(--sub);margin-bottom:8px">Очередь стратегий</div>
            </div>
        </div>

        <button type="button" class="go" id="go" onclick="submitPlan()">Запланировать</button>
        <button type="button" class="go" id="resolve" onclick="resolveConflicts()" style="background:#2a1542;border-color:#a855f7;color:#e8d5ff">Разрешить конфликты</button>
        <button type="button" class="reset" id="reset" onclick="resetDb()">Сбросить БД</button>
        <div id="result"></div>
    </div>

    <script>
        const APP_CACHE = 'schedule-v3';

        async function clearAppCache() {
            try { await caches.delete(APP_CACHE); } catch { }
        }

        async function logout() {
            try { await fetch('/App/Logout', { method: 'POST' }); } catch {}
            await clearAppCache();
            window.location.href = '/App/Login';
        }

        function maybeLogout(res) {
            if (res.status === 401) window.location.href = '/App/Login';
        }

        const rows = document.getElementById('rows');
        const strats = document.getElementById('strats');
        const STRATS_STORAGE_KEY = 'planner.strategies.v2';
        const QUEUE_STORAGE_KEY = 'planner.queue.v1';
        let restoring = false;

        // A strategy spec: { type: "prebuilt"|"composed", name?, picker?, slotter? }
        function makeSpec(type, name, picker, slotter) {
            return type === 'prebuilt'
                ? { '$type': 'prebuilt', name }
                : { '$type': 'composed', picker, slotter };
        }

        function specLabel(spec) {
            if (spec.$type === 'composed')
                return spec.picker + ' + ' + spec.slotter;
            return spec.name;
        }

        function addStratRow(spec) {
            const div = document.createElement('div');
            div.className = 'strat-row';

            const label = document.createElement('span');
            label.className = 'label';
            label.textContent = specLabel(spec);

            const up = document.createElement('button');
            up.type = 'button'; up.className = 'mv'; up.title = 'Выше'; up.textContent = '↑';
            up.onclick = () => { if (div.previousElementSibling?.classList.contains('strat-row')) strats.insertBefore(div, div.previousElementSibling); saveStrats(); };

            const down = document.createElement('button');
            down.type = 'button'; down.className = 'mv'; down.title = 'Ниже'; down.textContent = '↓';
            down.onclick = () => { if (div.nextElementSibling?.classList.contains('strat-row')) strats.insertBefore(div.nextElementSibling, div); saveStrats(); };

            const del = document.createElement('button');
            del.type = 'button'; del.className = 'del'; del.title = 'Убрать'; del.textContent = '✕';
            del.onclick = () => { div.remove(); saveStrats(); };

            div.append(label, up, down, del);
            // store spec on element for serialization
            div._spec = spec;
            strats.appendChild(div);
            saveStrats();
        }

        function addPrebuilt() {
            const sel = document.getElementById('prebuilt-select');
            addStratRow(makeSpec('prebuilt', sel.value));
        }

        function addComposed() {
            const picker = document.getElementById('picker-select').value;
            const slotter = document.getElementById('slotter-select').value;
            addStratRow(makeSpec('composed', null, picker, slotter));
        }

        function saveStrats() {
            if (restoring) return;
            const specs = [];
            for (const el of strats.querySelectorAll('.strat-row')) {
                if (el._spec) specs.push(el._spec);
            }
            try { localStorage.setItem(STRATS_STORAGE_KEY, JSON.stringify(specs)); } catch { }
        }

        function saveQueue() {
            if (restoring) return;
            const items = [];
            for (const row of rows.querySelectorAll('.row')) {
                const title = row.querySelector('.title').value.trim();
                const count = parseInt(row.querySelector('.count').value, 10);
                if (title && count > 0) items.push({ title, count });
            }
            try { localStorage.setItem(QUEUE_STORAGE_KEY, JSON.stringify(items)); } catch { }
        }

        function addRow(title = '', count = 1) {
            const div = document.createElement('div');
            div.className = 'row';
            div.innerHTML =
                '<input class="title" type="text" placeholder="Название предмета" />' +
                '<input class="count" type="number" min="1" />' +
                '<button type="button" class="del" title="Убрать">✕</button>';
            div.querySelector('.title').value = title;
            div.querySelector('.count').value = count;
            // auto-save queue on every change
            div.querySelector('.title').addEventListener('input', saveQueue);
            div.querySelector('.count').addEventListener('input', saveQueue);
            rows.appendChild(div);
        }

        rows.addEventListener('click', e => {
            if (e.target.classList.contains('del')) {
                e.target.closest('.row').remove();
                saveQueue();
            }
        });

        // Restore state from localStorage.
        // Server no longer pre-renders rows — all form state is client-side.
        (function init() {
            restoring = true;
            let saved = [];
            try { saved = JSON.parse(localStorage.getItem(STRATS_STORAGE_KEY) || '[]'); } catch { }
            for (const s of saved) {
                if (s.$type === 'prebuilt' || s.$type === 'composed')
                    addStratRow(s);
            }
            if (!strats.querySelector('.strat-row'))
                addStratRow(makeSpec('prebuilt', 'gap'));

            // restore queue from localStorage
            let queueItems = [];
            try { queueItems = JSON.parse(localStorage.getItem(QUEUE_STORAGE_KEY) || '[]'); } catch { }
            if (queueItems.length > 0) {
                for (const item of queueItems)
                    addRow(item.title, item.count);
            } else {
                addRow();
            }
            restoring = false;
        })();

        async function resolveConflicts() {
            const btn = document.getElementById('resolve');
            const result = document.getElementById('result');
            result.className = '';
            result.textContent = '';

            btn.disabled = true;
            try {
                const res = await fetch('/Planner/ResolveConflicts', { method: 'PATCH' });
                if (!res.ok) {
                    result.className = 'err';
                    result.textContent = 'Ошибка ' + res.status + ': ' + (await res.text());
                    return;
                }
                const data = await res.json();
                const days = data.success ? Object.keys(data.success).length : 0;
                // persist freed items so page reload pre-fills them
                if (data.queue) {
                    const items = [];
                    for (const [title, count] of Object.entries(data.queue)) {
                        if (count > 0) items.push({ title, count });
                    }
                    try { localStorage.setItem(QUEUE_STORAGE_KEY, JSON.stringify(items)); } catch { }
                }
                result.className = 'ok';
                result.innerHTML = 'Конфликты разрешены (затронуто дней: ' + days +
                    '). <a class="back" href="/App">открыть расписание →</a>';
            } catch {
                result.className = 'err';
                result.textContent = 'Сеть недоступна.';
            } finally {
                btn.disabled = false;
            }
        }

        async function resetDb() {
            const reset = document.getElementById('reset');
            const result = document.getElementById('result');
            result.className = '';
            result.textContent = '';
            if (!confirm('Снести все кастомные уроки и скрытия?')) return;

            reset.disabled = true;
            try {
                const res = await fetch('/Planner/Reset', { method: 'POST' });
                maybeLogout(res);
                if (!res.ok) {
                    result.className = 'err';
                    result.textContent = 'Ошибка ' + res.status + ': ' + (await res.text());
                    return;
                }
                const data = await res.json();
                result.className = 'ok';
                result.textContent = 'Сброшено: кастомных ' + data.cleared.custom + ', скрытий ' + data.cleared.deactivations + '.';
            } catch {
                result.className = 'err';
                result.textContent = 'Сеть недоступна.';
            } finally {
                reset.disabled = false;
            }
        }

        async function submitPlan() {
            const go = document.getElementById('go');
            const result = document.getElementById('result');
            result.className = '';
            result.textContent = '';

            const specs = [];
            for (const el of strats.querySelectorAll('.strat-row')) {
                if (el._spec) specs.push(el._spec);
            }
            if (specs.length === 0) {
                result.className = 'err';
                result.textContent = 'Добавь хотя бы одну стратегию.';
                return;
            }

            const params = [];
            let requested = 0;
            for (const row of rows.querySelectorAll('.row')) {
                const title = row.querySelector('.title').value.trim();
                const count = parseInt(row.querySelector('.count').value, 10);
                if (!title || !(count > 0)) continue;
                params.push('titles[' + encodeURIComponent(title) + ']=' + count);
                requested += count;
            }
            if (requested === 0) {
                result.className = 'err';
                result.textContent = 'Добавь хотя бы один предмет с количеством.';
                return;
            }

            go.disabled = true;
            try {
                const res = await fetch('/Planner?' + params.join('&'), {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                    body: JSON.stringify(specs)
                });
                maybeLogout(res);
                if (!res.ok) {
                    result.className = 'err';
                    result.textContent = 'Ошибка ' + res.status + ': ' + (await res.text());
                    return;
                }
                const data = await res.json();
                const failure = data.failure ?? 0;
                const placed = requested - failure;
                const days = data.success ? Object.keys(data.success).length : 0;
                // persist leftover queue so page reload pre-fills it
                if (data.queue) {
                    const items = [];
                    for (const [title, count] of Object.entries(data.queue)) {
                        if (count > 0) items.push({ title, count });
                    }
                    try { localStorage.setItem(QUEUE_STORAGE_KEY, JSON.stringify(items)); } catch { }
                }
                result.className = 'ok';
                result.innerHTML = 'Размещено пар: ' + placed + ' (в ' + days + ' дн.), не влезло: ' + failure +
                    '. <a class="back" href="/App">открыть расписание →</a>';
            } catch {
                result.className = 'err';
                result.textContent = 'Сеть недоступна.';
            } finally {
                go.disabled = false;
            }
        }
    </script>
</body>
</html>
