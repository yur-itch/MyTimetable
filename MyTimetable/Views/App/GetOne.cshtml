@using MyTimetable.Models
@model DaySchedule
@{ Layout = null; }
@functions {
    static readonly string[] Weekdays = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };

    static readonly Dictionary<string, string> Abbrevs = new()
    {
        ["Физическая культура и спорт"]                                                          = "Физра",
        ["Элективные дисциплины по физической культуре и спорту"]                                = "Физра",
        ["Алгебра и геометрия"]                                                                  = "Алгем",
        ["Критическое мышление в ИТ"]                                                            = "Критмыш",
        ["Математический анализ"]                                                                = "Матан",
        ["Ознакомительная практика (учебная)"]                                                   = "Практика",
        ["Основы программирования"]                                                              = "Прога",
        ["Основы дискретной логики и теории доказательств"]                                      = "МКН1",
        ["Основы российской государственности"]                                                  = "ОРГ",
        ["Парадигмы программирования"]                                                           = "Парадигмы",
        ["Погружение в университетскую среду"]                                                   = "Погружение",
        ["Практикум по программированию"]                                                        = "Прога",
        ["Безопасность жизнедеятельности"]                                                       = "БЖД",
        ["Введение в программирование"]                                                          = "Прога",
        ["Дискретная теория вероятности и основы математической статистики"]                     = "МКН3",
        ["Дискретные структуры"]                                                                 = "МКН2",
        ["Иностранный язык"]                                                                     = "Английский",
        ["История России"]                                                                       = "История",
    };

    static string ShortTitle(string title)
        => Abbrevs.TryGetValue(title, out var s) ? s : title;

    static string Accent(string type) => type switch
    {
        "PRACTICE" => "#3b82f6",
        "SEMINAR" => "#f59e0b",
        "LECTURE" => "#e11d48",
        "EXAM" or "CONTROL_POINT" or "DIFFERENTIAL_CREDIT" or "CREDIT" => "#a855f7",
        "CONSULTATION" => "#ec4899",
        _ => "#6b7280",
    };
    static string AccentBg(string type) => type switch
    {
        "PRACTICE" => "#11294d",
        "SEMINAR" => "#3a2410",
        "LECTURE" => "#3d1320",
        "EXAM" or "CONTROL_POINT" or "DIFFERENTIAL_CREDIT" or "CREDIT" => "#2a1542",
        "CONSULTATION" => "#3a132b",
        _ => "#1f232b",
    };
}
@{
    DateOnly date = Model.Date;
    int dow = ((int)date.DayOfWeek + 6) % 7;
    var dateStr = date.ToString("yyyy-MM-dd");
}
<div id="day-@dateStr" style="display:contents">
    <div class="cell s-left day-label">
        <div class="day-name">@Weekdays[dow]</div>
        <div class="day-date">@date.Day.@date.Month</div>
    </div>
    @for (int i = 0; i < Model.Cells.Length; i++)
    {
        // В одном слоте может быть до двух уроков: дефолтный и кастомный. Один растягивается на всю
        // ячейку, два встают столбиком. Скрывается только дефолтный (data-num + класс hidden);
        // кастомный без data-num — клик по нему ничего не делает.
        var cell = Model.Cells[i];
        var num = i + 1;
        <div class="cell day-cell">
            @if (cell.DefaultLesson is { } def)
            {
                <div class="lesson@(cell.Hidden ? " hidden" : "")" data-num="@num" style="--accent:@Accent(def.LessonType);--accent-bg:@AccentBg(def.LessonType)">
                    <div class="lesson-title">@ShortTitle(def.Title)</div>
                    @if (def.Room.Length > 0)
                    {
                        <div class="lesson-room">@def.Room</div>
                    }
                    @if (def.Professor.IsShown && def.Professor.Name.Length > 0)
                    {
                        <div class="lesson-prof">@def.Professor.Name</div>
                    }
                </div>
            }
            @if (cell.CustomLesson is { } cust)
            {
                <div class="lesson custom" style="--accent:@Accent(cust.LessonType);--accent-bg:@AccentBg(cust.LessonType)">
                    <div class="lesson-title">@ShortTitle(cust.Title)</div>
                </div>
            }
        </div>
    }
</div>
