@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Регистрация — Расписание</title>
    <style>
        :root {
            --bg: #0a0a0f;
            --line: #1b1b24;
            --fg: #e8e8ef;
            --sub: #6b6b7b;
            --accent: #3b82f6;
            --accent-bg: #11294d;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--bg);
            color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wrap {
            width: 100%;
            max-width: 340px;
            padding: 32px 24px;
        }

        h1 {
            font-size: 20px;
            margin: 0 0 24px;
            text-align: center;
        }

        label {
            display: block;
            font-size: 13px;
            color: var(--sub);
            margin: 16px 0 6px;
        }

        input {
            width: 100%;
            background: #13131c;
            border: 1px solid var(--line);
            color: var(--fg);
            border-radius: 6px;
            padding: 10px 12px;
            font-size: 14px;
        }
        input:focus { outline: none; border-color: var(--accent); }

        button {
            width: 100%;
            margin-top: 24px;
            background: var(--accent-bg);
            border: 1px solid var(--accent);
            color: #cfe0ff;
            border-radius: 8px;
            padding: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover { background: #173667; }
        button:disabled { opacity: .5; cursor: default; }

        #error {
            margin-top: 16px;
            font-size: 14px;
            color: #e88;
            text-align: center;
            min-height: 20px;
        }

        .switch {
            margin-top: 18px;
            text-align: center;
            font-size: 13px;
            color: var(--sub);
        }
        .switch a {
            color: var(--accent);
            text-decoration: none;
        }
        .switch a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="wrap">
        <h1>Регистрация</h1>
        <form id="register-form" autocomplete="off">
            <label for="username">Логин</label>
            <input id="username" type="text" autocomplete="username" />
            <label for="password">Пароль</label>
            <input id="password" type="password" autocomplete="new-password" />
            <button type="submit" id="submit-btn">Зарегистрироваться</button>
            <div id="error"></div>
        </form>
        <div class="switch">Уже есть аккаунт? <a href="/App/Login">Войти</a></div>
    </div>
    <script>
        async function clearAppCache() {
            try { await caches.delete('schedule-v3'); } catch { }
        }

        function clearLegacySession() {
            try { localStorage.removeItem('mytimetable.session'); } catch { }
        }

        document.getElementById('register-form').addEventListener('submit', async e => {
            e.preventDefault();
            const btn = document.getElementById('submit-btn');
            const err = document.getElementById('error');
            err.textContent = '';

            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            if (!username || !password) {
                err.textContent = 'Заполни оба поля.';
                return;
            }

            btn.disabled = true;
            try {
                const res = await fetch('/App/Register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                if (!res.ok) {
                    if (res.status === 409) {
                        err.textContent = 'Пользователь с таким именем уже существует.';
                    } else {
                        const data = await res.json().catch(() => ({}));
                        err.textContent = data.error || 'Ошибка ' + res.status;
                    }
                    return;
                }
                await clearAppCache();
                clearLegacySession();
                window.location.href = '/App';
            } catch {
                err.textContent = 'Сеть недоступна.';
            } finally {
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>
