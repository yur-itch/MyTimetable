@using MyTimetable.Models
@model PageView
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Расписание</title>
    <style>
        :root {
            --bg: #0a0a0f;
            --line: #1b1b24;
            --fg: #e8e8ef;
            --sub: #6b6b7b;
            --row-min: 184px;
            --day-w: 58px;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--bg);
            color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        #scroller { height: 100vh; overflow: auto; }

        .grid {
            display: grid;
            grid-template-columns: var(--day-w) repeat(@Model.SlotCount, minmax(110px, 1fr));
            border-top: 1px solid var(--line);
            border-left: 1px solid var(--line);
        }

        .cell {
            border-right: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }

        .s-top  { position: sticky; top: 0;  z-index: 5;  background: var(--bg); }
        .s-left { position: sticky; left: 0; z-index: 5;  background: var(--bg); }
        .s-both { position: sticky; top: 0; left: 0; z-index: 10; background: var(--bg); }

        .slot-head {
            padding: 6px 8px;
            min-height: 46px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .slot-start { font-size: 13px; font-weight: 600; }
        .slot-end   { font-size: 12px; color: var(--sub); margin-top: 1px; }

        .day-label {
            padding: 8px 6px;
            height: var(--row-min);
            display: flex;
            flex-direction: column;
        }
        .day-name { font-size: 16px; font-weight: 600; }
        .day-date { font-size: 16px; color: var(--sub); margin-top: 2px; }

        .day-cell {
            padding: 5px;
            height: var(--row-min);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .lesson {
            border-radius: 5px;
            border-left: 4px solid var(--accent);
            background: var(--accent-bg);
            padding: 7px 9px;
            flex: 1 1 0;
            min-height: 0;
            overflow: hidden;
        }
        .editable .lesson { cursor: pointer; }
        .lesson.hidden { opacity: .32; }
        .lesson.custom { cursor: default; }
        .lesson-title { font-size: 13px; font-weight: 600; line-height: 1.25; color: #f3f3f8; }
        .lesson-prof  { font-size: 12px; margin-top: 3px; color: rgba(255,255,255,.62); }
        .lesson-room  { font-size: 12px; margin-top: 2px; color: rgba(255,255,255,.45); }

        .day-cell { content-visibility: auto; contain-intrinsic-size: 184px; }

        .plan-btn {
            position: fixed;
            top: 8px;
            left: 8px;
            z-index: 20;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #11294d;
            border: 1px solid #3b82f6;
            color: #cfe0ff;
            font-size: 22px;
            line-height: 1;
            text-decoration: none;
        }
        .plan-btn:hover { background: #173667; }

        .logout-btn {
            position: fixed;
            top: 8px;
            right: 8px;
            z-index: 20;
            height: 32px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #1a1320;
            border: 1px solid #5b2330;
            color: #e88;
            font-size: 13px;
            cursor: pointer;
        }
        .logout-btn:hover { background: #271826; }
    </style>
</head>
<body class="@(Model.CanEdit ? "editable" : "")">
@if (Model.CanEdit)
{
    <a class="plan-btn" href="/App/Plan" title="Планирование">+</a>
}
    <button class="logout-btn" onclick="logout()" title="Выйти">выход</button>
    <div id="scroller">
        <div class="grid">
            <div class="cell s-both"></div>
            @for (int num = 1; num <= Model.SlotCount; num++)
            {
                <div class="cell s-top slot-head">
                    <div class="slot-start">Пара @num</div>
                </div>
            }
            @foreach (var piece in Model.Days)
            {
                @Html.Raw(piece)
            }
        </div>
    </div>
    <script>
        async function setServiceWorkerMode(mode) {
            if (!('serviceWorker' in navigator)) return;
            try {
                const registration = await navigator.serviceWorker.register('/sw.js');
                const worker = registration.active ?? (await navigator.serviceWorker.ready).active;
                worker?.postMessage({ type: 'set-mode', mode });
            } catch { }
        }

        function maybeLogout(res) {
            if (res.status === 401) {
                setServiceWorkerMode(null);
                clearLegacySession();
                window.location.href = '/App/Login';
            }
        }

        function clearLegacySession() {
            try { localStorage.removeItem('mytimetable.session'); } catch { }
        }

        requestAnimationFrame(() => {
            const cur = document.getElementById("@Model.ScrollTarget");
            if (cur) (cur.firstElementChild ?? cur).scrollIntoView({ block: "center" });
        });

        document.querySelector('.grid').addEventListener('click', e => {
@if (Model.CanEdit)
{
<text>            const lesson = e.target.closest('.lesson');
            if (lesson) { toggleLesson(lesson); return; }
</text>
}
            const label = e.target.closest('.day-label');
            if (!label) return;
            const id = label.closest('[id^="day-"]')?.id;
            if (id) refreshDay(id.slice(4));
        });

@if (Model.CanEdit)
{
<text>
        async function toggleLesson(el) {
            const dateStr = el.closest('[id^="day-"]')?.id.slice(4);
            const num = el.dataset.num;
            if (!dateStr || !num) return;
            const action = el.classList.contains('hidden') ? 'Unhide' : 'Hide';
            try {
                // PATCH сразу возвращает обновлённый партиал дня — вставляем его, без отдельного GET.
                const res = await fetch('/App/' + action + '?date=' + dateStr + '&lessonNumber=' + num, { method: 'PATCH' });
                maybeLogout(res);
                if (res.ok) swapDay(dateStr, await res.text());
            } catch {}
        }
</text>
}

        async function refreshDay(dateStr) {
            try {
                const res = await fetch('/App/GetOne?date=' + dateStr);
                maybeLogout(res);
                if (res.ok) swapDay(dateStr, await res.text());
            } catch {}
        }

        async function logout() {
            try {
                await fetch('/App/Logout', { method: 'POST' });
            } catch {}
            await setServiceWorkerMode(null);
            clearLegacySession();
            window.location.href = '/App/Login';
        }

        function swapDay(dateStr, html) {
            const wrapper = document.getElementById('day-' + dateStr);
            if (!wrapper) return;
            const tmp = document.createElement('div');
            tmp.innerHTML = html;
            const next = tmp.querySelector('[id="day-' + dateStr + '"]');
            if (next) wrapper.replaceWith(next);
        }

        setServiceWorkerMode('@(Model.CanEdit ? "editor" : "viewer")');
    </script>
</body>
</html>
