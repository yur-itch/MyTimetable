@using System.Globalization
@using MyTimetable.Models
@model List<DaySchedule>
@functions {
    static string FmtTime(int sec)
    {
        int t = (((sec + 25200) % 86400) + 86400) % 86400;
        return $"{t / 3600}:{(t % 3600) / 60:D2}";
    }
}
@{
    var slotMap = new SortedDictionary<int, (int starts, int ends)>();
    foreach (var day in Model)
        foreach (var l in day.Lessons ?? new())
            if (!slotMap.ContainsKey(l.LessonNumber))
                slotMap[l.LessonNumber] = (l.Starts, l.Ends);
    var slots = slotMap.ToList();
    if (slots.Count > 0) slots.RemoveAt(slots.Count - 1);

    var today = DateTime.Now.Date;
    var allDates = new SortedSet<DateTime>();
    foreach (var day in Model)
        if (DateTime.TryParseExact(day.Date, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt)
            && ((int)dt.DayOfWeek + 6) % 7 <= 6)
            allDates.Add(dt);
    var sortedDates = allDates.ToList();
    int currentIdx = sortedDates.FindLastIndex(dt => dt <= today);
    if (currentIdx < 0) currentIdx = 0;
    string scrollTarget = "day-" + sortedDates[currentIdx].ToString("yyyy-MM-dd");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Расписание</title>
    <style>
        :root {
            --bg: #0a0a0f;
            --line: #1b1b24;
            --fg: #e8e8ef;
            --sub: #6b6b7b;
            --row-min: 92px;
            --day-w: 58px;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            height: 100%;
            background: var(--bg);
            color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        #scroller { height: 100vh; overflow: auto; }

        .grid {
            display: grid;
            grid-template-columns: var(--day-w) repeat(@slots.Count, minmax(110px, 1fr));
            border-top: 1px solid var(--line);
            border-left: 1px solid var(--line);
        }

        .cell {
            border-right: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }

        .s-top  { position: sticky; top: 0;  z-index: 5;  background: var(--bg); }
        .s-left { position: sticky; left: 0; z-index: 5;  background: var(--bg); }
        .s-both { position: sticky; top: 0; left: 0; z-index: 10; background: var(--bg); }

        .slot-head {
            padding: 6px 8px;
            min-height: 46px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .slot-start { font-size: 13px; font-weight: 600; }
        .slot-end   { font-size: 12px; color: var(--sub); margin-top: 1px; }

        .day-label {
            padding: 8px 6px;
            min-height: var(--row-min);
            display: flex;
            flex-direction: column;
        }
        .day-name { font-size: 13px; font-weight: 600; }
        .day-date { font-size: 11px; color: var(--sub); margin-top: 2px; }

        .refresh-btn {
            margin-top: auto;
            padding: 0;
            background: none;
            border: none;
            color: var(--sub);
            cursor: pointer;
            font-size: 15px;
            line-height: 1;
            opacity: 0.5;
        }
        .refresh-btn:hover { opacity: 1; color: var(--fg); }
        .refresh-btn:disabled { opacity: 0.2; cursor: default; }

        .day-cell {
            padding: 5px;
            min-height: var(--row-min);
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .lesson {
            border-radius: 5px;
            border-left: 4px solid var(--accent);
            background: var(--accent-bg);
            padding: 7px 9px;
            flex: 1 1 auto;
            overflow: hidden;
        }
        .lesson-title { font-size: 13px; font-weight: 600; line-height: 1.25; color: #f3f3f8; }
        .lesson-prof  { font-size: 12px; margin-top: 3px; color: rgba(255,255,255,.62); }

        .lp { --accent: #3b82f6; --accent-bg: #11294d; }
        .ls { --accent: #f59e0b; --accent-bg: #3a2410; }
        .ll { --accent: #e11d48; --accent-bg: #3d1320; }
        .le { --accent: #a855f7; --accent-bg: #2a1542; }
        .lc { --accent: #ec4899; --accent-bg: #3a132b; }
        .ld { --accent: #6b7280; --accent-bg: #1f232b; }
    </style>
</head>
<body>
    <div id="scroller">
        <div class="grid">
            <div class="cell s-both"></div>
            @foreach (var (num, t) in slots)
            {
                <div class="cell s-top slot-head">
                    <div class="slot-start">@FmtTime(t.starts)</div>
                    <div class="slot-end">@FmtTime(t.ends)</div>
                </div>
            }
            @await Html.PartialAsync("GetPartial", Model)
        </div>
    </div>
    <script>
        var cur = document.getElementById("@scrollTarget");
        if (cur) cur.scrollIntoView({ block: "start" });

        async function refreshDay(dateStr) {
            const wrapper = document.getElementById('day-' + dateStr);
            if (!wrapper) return;
            const btn = wrapper.querySelector('.refresh-btn');
            if (btn) btn.disabled = true;
            try {
                const res = await fetch('/App/GetPartial?dateFrom=' + dateStr + '&dateTo=' + dateStr);
                const tmp = document.createElement('div');
                tmp.innerHTML = await res.text();
                const next = tmp.querySelector('[id="day-' + dateStr + '"]');
                if (next) wrapper.replaceWith(next);
            } catch {
                if (btn) btn.disabled = false;
            }
        }

        document.querySelector('.grid').addEventListener('click', e => {
            const btn = e.target.closest('.refresh-btn');
            if (!btn) return;
            const id = btn.closest('[id^="day-"]')?.id;
            if (id) refreshDay(id.slice(4));
        });
    </script>
</body>
</html>
